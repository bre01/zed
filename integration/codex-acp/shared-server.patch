+import {describe, expect, it, vi} from "vitest";
+import {HistoryPagination, HISTORY_PAGINATION_META_KEY, HISTORY_PAGE_METHOD} from "../../HistoryPagination";
+import type {Thread, ThreadItem, Turn} from "../../app-server/v2";
+import {createCodexMockTestFixture, createTestModel} from "../acp-test-utils";
+
+function messages(count: number): ThreadItem[] {
+    return Array.from({length: count}, (_, index) => ({
+        type: "agentMessage", id: String(index), text: `Message ${index}`,
+        phase: "final_answer", memoryCitation: null, delivery: null, questions: null,
+    }));
+}
+
+describe("lazy history", () => {
+    it("reads only the latest page and excludes items persisted after resume", async () => {
+        const fixture = createCodexMockTestFixture();
+        const client = fixture.getCodexAppServerClient();
+        const stored = messages(260); // Resume happened at item 249; 250–259 are live.
+        const read = vi.spyOn(client, "threadItemsList").mockImplementation(async params => {
+            expect(params.sortDirection).toBe("desc");
+            const end = Number(String(params.cursor).slice("before:".length)) + 1;
+            const start = Math.max(0, end - (params.limit ?? 100));
+            return {
+                data: stored.slice(start, end).reverse().map(item => ({
+                    item, turnId: "turn", startedAtMs: null, completedAtMs: null,
+                })),
+                nextCursor: start > 0 ? `before:${start - 1}` : null,
+                backwardsCursor: null,
+            };
+        });
+        const pages = HistoryPagination.paginated(client, "thread", "before:249");
+        const tail = await pages.read();
+        expect(tail.items.map(item => item.id)).toEqual(stored.slice(150, 250).map(item => item.id));
+        expect(read).toHaveBeenCalledTimes(1); // No prefetch of unseen history.
+        const middle = await pages.read(tail.nextCursor);
+        expect(await pages.read(tail.nextCursor)).toEqual(middle); // Safe retry.
+        const first = await pages.read(middle.nextCursor);
+        expect([...first.items, ...middle.items, ...tail.items]).toEqual(stored.slice(0, 250));
+        expect(first.nextCursor).toBeNull();
+        await expect(HistoryPagination.paginated(client, "another", "before:249")
+            .read(tail.nextCursor)).rejects.toThrow("different session load");
+    });
+
+    it("does not read later live items when resume had an empty snapshot", async () => {
+        const fixture = createCodexMockTestFixture();
+        const client = fixture.getCodexAppServerClient();
+        const read = vi.spyOn(client, "threadItemsList");
+        expect(await HistoryPagination.paginated(client, "thread", null).read())
+            .toEqual({items: [], nextCursor: null});
+        expect(read).not.toHaveBeenCalled();
+    });
+
+    it("keeps legacy history complete while replaying only its tail initially", async () => {
+        const items = messages(250);
+        const pages = HistoryPagination.legacy(items);
+        const tail = await pages.read();
+        const middle = await pages.read(tail.nextCursor);
+        const first = await pages.read(middle.nextCursor);
+        expect([tail.items.length, middle.items.length, first.items.length]).toEqual([100, 100, 50]);
+        expect([...first.items, ...middle.items, ...tail.items]).toEqual(items);
+        expect(first.nextCursor).toBeNull();
+        expect(await pages.read(tail.nextCursor)).toEqual(middle);
+    });
+
+    it("negotiates tail replay and returns older updates without appending them to live notifications", async () => {
+        const fixture = createCodexMockTestFixture();
+        const client = fixture.getCodexAcpClient();
+        const server = fixture.getCodexAppServerClient();
+        client.readAuthRequirement = vi.fn().mockResolvedValue({required: false, account: null});
+        client.getAccount = vi.fn().mockResolvedValue({account: null, requiresOpenaiAuth: false});
+        client.listSkills = vi.fn().mockResolvedValue({data: []});
+        const model = createTestModel();
+        server.listModels = vi.fn().mockResolvedValue({data: [model], nextCursor: null});
