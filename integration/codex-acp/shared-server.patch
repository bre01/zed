+import {describe, expect, it, vi} from "vitest";
+import {createCodexMockTestFixture, createTestModel} from "../acp-test-utils";
+import type {Thread} from "../../app-server/v2";
+import {rememberServerRequest} from "../../ServerRequestIdentity";
+
+describe("shared app-server sessions", () => {
+    async function loadSharedSession() {
+        const fixture = createCodexMockTestFixture();
+        const client = fixture.getCodexAcpClient();
+        const server = fixture.getCodexAppServerClient();
+        client.readAuthRequirement = vi.fn().mockResolvedValue({required: false, account: null});
+        client.getAccount = vi.fn().mockResolvedValue({account: null, requiresOpenaiAuth: false});
+        client.listSkills = vi.fn().mockResolvedValue({data: []});
+        const model = createTestModel();
+        server.listModels = vi.fn().mockResolvedValue({data: [model], nextCursor: null});
+        const thread = {id: "shared-thread", historyMode: "legacy", turns: []} as unknown as Thread;
+        server.threadResume = vi.fn().mockResolvedValue({
+            thread, model: model.id, modelProvider: "openai", cwd: "/workspace",
+            approvalPolicy: "never", sandbox: {type: "dangerFullAccess"},
+            reasoningEffort: model.defaultReasoningEffort,
+        });
+        server.threadReadWithHistory = vi.fn().mockResolvedValue({thread});
+        const agent = fixture.getCodexAcpAgent();
+        await agent.initialize({protocolVersion: 1, clientCapabilities: {}});
+        await agent.loadSession({sessionId: thread.id, cwd: "/workspace", mcpServers: []});
+        fixture.clearAcpConnectionDump();
+        return {fixture, agent, server, thread};
+    }
+
+    it("forwards another client's messages without a Zed prompt and detaches without interrupting", async () => {
+        const {fixture, agent, server, thread} = await loadSharedSession();
+        expect(server.threadResume).toHaveBeenCalledWith({threadId: thread.id, excludeTurns: true});
+        fixture.sendServerNotification({method: "turn/started", params: {
+            threadId: thread.id, turn: {id: "external-turn", status: "inProgress", items: []},
+        }});
+        fixture.sendServerNotification({method: "item/started", params: {
+            threadId: thread.id, turnId: "external-turn", item: {
+                id: "external-user", type: "userMessage", clientId: "desktop",
+                content: [{type: "text", text: "From Desktop", text_elements: []}],
+            },
+        }});
+        fixture.sendServerNotification({method: "item/agentMessage/delta", params: {
+            threadId: thread.id, turnId: "external-turn", itemId: "external-answer", delta: "Shared answer",
+        }});
+        await vi.waitFor(() => expect(fixture.getAcpConnectionEvents([])
+            .filter(event => event.method === "sessionUpdate")
+            .map(event => event.args[0].update)
+            .filter(update => ["user_message_chunk", "agent_message_chunk"].includes(update.sessionUpdate))
+            .map(update => update.content.text)).toEqual(["From Desktop", "Shared answer"]));
+        expect(agent.getSessionState(thread.id).currentTurnId).toBe("external-turn");
+        fixture.clearCodexConnectionDump();
+        await agent.closeSession({sessionId: thread.id});
+        expect(fixture.getCodexConnectionEvents([]).filter(event => event.eventType === "request")
+            .map(event => event.method)).toEqual(["thread/unsubscribe"]);
+    });
+
+    it("does not auto-deny a pending approval owned by another client", async () => {
+        const {fixture, thread} = await loadSharedSession();
+        const params = {threadId: thread.id, turnId: "external-turn", itemId: "command", command: "ls"};
+        rememberServerRequest({jsonrpc: "2.0", method: "item/commandExecution/requestApproval", id: 42, params});
+        const settled = vi.fn();
+        const response = fixture.sendServerRequest("item/commandExecution/requestApproval", params).then(settled);
+        await new Promise(resolve => setImmediate(resolve));
+        expect(settled).not.toHaveBeenCalled();
+        fixture.sendServerNotification({method: "serverRequest/resolved", params: {threadId: thread.id, requestId: 42}});
+        await response;
+        expect(settled).toHaveBeenCalledOnce();
+    });
+});
diff --git a/src/__tests__/IsolatedCodexConnection.ts b/src/__tests__/IsolatedCodexConnection.ts
new file mode 100644
index 0000000..817d809
--- /dev/null
+++ b/src/__tests__/IsolatedCodexConnection.ts
@@ -0,0 +1,24 @@
+import {spawn, type ChildProcessWithoutNullStreams} from "node:child_process";
+import {createRequire} from "node:module";
+import * as rpc from "vscode-jsonrpc/node";
+import {afterEach} from "vitest";
+import type {CodexConnection} from "../CodexJsonRpcConnection";
+import {createJSONRPCReader, createJSONRPCWriter} from "../StdUtils";
+
+const ownedProcesses = new Set<ChildProcessWithoutNullStreams>();
+afterEach(() => {
+    for (const child of ownedProcesses) child.kill();
+    ownedProcesses.clear();
+});
+
+/** Isolated auth/config fixtures must never log into or change the user's daemon. */
+export function startCodexConnection(codexPath?: string, env?: NodeJS.ProcessEnv): CodexConnection {
+    const child = codexPath
+        ? spawn(codexPath, ["app-server"], {env: env ?? process.env, shell: process.platform === "win32"})
+        : spawn(process.execPath, [createRequire(import.meta.url).resolve("@openai/codex/bin/codex.js"), "app-server"], {env: env ?? process.env});
+    ownedProcesses.add(child);
+    const connection = rpc.createMessageConnection(createJSONRPCReader(child.stdout), createJSONRPCWriter(child.stdin));
+    connection.listen();
+    child.on("exit", () => {ownedProcesses.delete(child); connection.dispose();});
+    return {connection, process: child};
+}
