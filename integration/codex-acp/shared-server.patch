diff --git a/src/HistoryPagination.ts b/src/HistoryPagination.ts
new file mode 100644
index 0000000..650bac2
--- /dev/null
+++ b/src/HistoryPagination.ts
@@ -0,0 +1,62 @@
+import type {ClientCapabilities} from "@agentclientprotocol/sdk";
+import {randomUUID} from "node:crypto";
+import type {ThreadItem} from "./app-server/v2";
+import type {CodexAppServerClient} from "./CodexAppServerClient";
+
+export const HISTORY_PAGINATION_META_KEY = "zed.dev/historyPagination";
+export const HISTORY_PAGE_METHOD = "_zed/history/page";
+export const HISTORY_PAGE_SIZE = 100;
+
+export function supportsHistoryPagination(capabilities: ClientCapabilities | null): boolean {
+    const value = capabilities?._meta?.[HISTORY_PAGINATION_META_KEY];
+    return typeof value === "object" && value !== null && "version" in value && value.version === 1;
+}
+
+export interface HistoryPage {
+    /** Complete native items, ordered from oldest to newest within this page. */
+    items: ThreadItem[];
+    nextCursor: string | null;
+}
+
+/** A read-only snapshot boundary; reading an older page never resumes the thread. */
+export class HistoryPagination {
+    private readonly prefix = `${randomUUID()}:`;
+
+    private constructor(private readonly readPage: (cursor: string | null) => Promise<HistoryPage>) {}
+
+    static paginated(client: CodexAppServerClient, threadId: string, boundary: string | null): HistoryPagination {
+        return new HistoryPagination(async cursor => {
+            // A null resume boundary represents an empty snapshot, even if a live
+            // item has been persisted since resume returned.
+            if (boundary === null) return {items: [], nextCursor: null};
+            const page = await client.threadItemsHistoryPage({
+                threadId, cursor: cursor ?? boundary, limit: HISTORY_PAGE_SIZE, sortDirection: "desc",
+            });
+            if (page.nextCursor !== null && page.nextCursor === (cursor ?? boundary)) {
+                throw new Error("Codex history pagination returned a repeated cursor");
+            }
+            return {items: page.data.map(entry => entry.item).reverse(), nextCursor: page.nextCursor};
+        });
+    }
+
+    static legacy(items: ThreadItem[]): HistoryPagination {
+        // Legacy stores expose only a full-history read. Keep that snapshot in
+        // the adapter, but construct at most one page of Zed entities at a time.
+        return new HistoryPagination(async cursor => {
+            const end = cursor === null ? items.length : Number(cursor);
+            if (!Number.isSafeInteger(end) || end < 0 || end > items.length) {
+                throw new Error("Invalid legacy history cursor");
+            }
+            const start = Math.max(0, end - HISTORY_PAGE_SIZE);
+            return {items: items.slice(start, end), nextCursor: start > 0 ? String(start) : null};
+        });
+    }
+
+    async read(cursor: string | null = null): Promise<HistoryPage> {
+        if (cursor !== null && !cursor.startsWith(this.prefix)) {
+            throw new Error("History cursor belongs to a different session load");
+        }
+        const page = await this.readPage(cursor === null ? null : cursor.slice(this.prefix.length));
+        return {...page, nextCursor: page.nextCursor === null ? null : this.prefix + page.nextCursor};
+    }
+}
diff --git a/src/ServerRequestIdentity.ts b/src/ServerRequestIdentity.ts
new file mode 100644
index 0000000..d667087
--- /dev/null
+++ b/src/ServerRequestIdentity.ts
@@ -0,0 +1,23 @@
+import type {Message, RequestMessage} from "vscode-jsonrpc/node";
+
+// vscode-jsonrpc passes params to handlers, but omits the request id. Keep the
+// identity so a passive subscriber can wait for serverRequest/resolved.
+const requestIds = new WeakMap<object, string | number>();
+
+export function rememberServerRequest(message: Message | RequestMessage): void {
+    if ("method" in message && "id" in message && "params" in message
+        && (typeof message.id === "string" || typeof message.id === "number")
+        && message.params !== null && typeof message.params === "object") {
+        requestIds.set(message.params, message.id);
+    }
+}
+
+export function serverRequestId(params: object): string | number | undefined {
+    return requestIds.get(params);
+}
+
+export function copyServerRequestIdentity<T extends object>(source: object, target: T): T {
+    const id = requestIds.get(source);
+    if (id !== undefined) requestIds.set(target, id);
+    return target;
+}
